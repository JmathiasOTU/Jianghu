{
  "name": "Jianghu",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/Shared"
      },
      "Packages": {
        "$path": "Packages"
      },
      "Assets": {
        "$className": "Folder",
        "Animations": {
          "$className": "Folder",
          "Movement": {
            "$path": "Assets/Animations/Movement.model.json"
          }
        },
        "FX": {
          "$className": "Folder",
          "Movement": {
            "$className": "Folder",
            "HumanoidRootPart": {
              "$className": "Folder",
              "RootAttachment": {
                "$className": "Folder"
              }
            },
            "Left Leg": {
              "$className": "Folder",
              "LeftFootAttachment": {
                "$className": "Folder",
                "Footstep": {
                  "$path": "Assets/FX/Footsteps.model.json"
                }
              }
            },
            "Right Leg": {
              "$className": "Folder",
              "RightFootAttachment": {
                "$className": "Folder",
                "Footstep": {
                  "$path": "Assets/FX/Footsteps.model.json"
                }
              }
            }
          }
        }
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "Footsteps": {
        "$className": "SoundGroup"
      },
      "Loops": {
        "$className": "SoundGroup"
      },
      "Impacts": {
        "$className": "SoundGroup"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/Server"
      },
      "ServerPackages": {
        "$path": "ServerPackages"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "MovementDebugOverlay": {
        "$path": "Assets/UI/MovementDebugOverlay.model.json"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/Client"
        }
      }
    }
  }
}
